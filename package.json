{
  "name": "react-public-components",
  "version": "0.1.1",
  "description": "React 折叠容器（CollapseBox）与分屏面板（Splitter）组件，零 UI 库依赖",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.less",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "build:demo": "vite build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "splitter",
    "collapse",
    "layout",
    "component"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild-plugin-less": "^1.3.1",
    "less": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}