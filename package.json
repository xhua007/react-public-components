{
	"name": "react-public-components",
	"version": "1.2.8",
	"description": "企业级现代 React 通用核心组件库，零 UI 库依赖，开箱即用",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typings": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./styles.css": "./styles.css",
		"./*": {
			"types": "./dist/*/index.d.ts",
			"import": "./dist/*/index.js",
			"require": "./dist/*/index.cjs"
		}
	},
	"files": [
		"dist",
		"styles.css",
		"index.js",
		"index.d.ts"
	],
	"sideEffects": [
		"**/*.less",
		"**/*.css"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsup && tsc --emitDeclarationOnly && node -e \"fs.writeFileSync('dist/index.d.ts', 'export * from \\\"./src/index\\\";\\n')\"",
		"build:demo": "vite build",
		"lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext ts,tsx --report-unused-disable-directives",
		"format": "prettier --write \"**/*.{ts,tsx,json,md,less,css}\"",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"react",
		"splitter",
		"collapse",
		"layout",
		"component"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xhua007/react-public-components.git"
	},
	"homepage": "https://github.com/xhua007/react-public-components#readme",
	"bugs": {
		"url": "https://github.com/xhua007/react-public-components/issues"
	},
	"peerDependencies": {
		"react": ">=16.8.0",
		"react-dom": ">=16.8.0"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vitejs/plugin-react": "^6.0.3",
		"esbuild-plugin-less": "^1.3.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"less": "^4.2.0",
		"prettier": "^3.9.6",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"tsup": "^8.0.0",
		"typescript": "^5.4.0",
		"vite": "^8.1.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
